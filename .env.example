# --- LLM backend ------------------------------------------------------------
# Local/dev default: Ollama. Make sure `ollama serve` is running and the model
# is pulled (e.g. `ollama pull qwen2.5-coder:7b`).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Production (Railway has no GPU): set LLM_PROVIDER=openai and point this at a
# remote OpenAI-compatible endpoint — a hosted provider OR a remote Ollama box
# (Ollama's OpenAI-compatible API lives at <host>/v1).
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=300

# --- GitHub App (only needed for the GitHub bot) ----------------------------
# Create a GitHub App, give it Pull requests: read/write + Contents: read,
# subscribe to the "Pull request" event, and point the webhook URL at
# https://<your-railway-url>/webhook/github
# GITHUB_APP_ID=123456
# Paste the PEM private key. In a single-line env var, encode newlines as \n.
# GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# GITHUB_WEBHOOK_SECRET=some-long-random-string

# --- Guardrails -------------------------------------------------------------
MAX_DIFF_BYTES=400000
MAX_FILES=60
MAX_FILE_BYTES=60000
